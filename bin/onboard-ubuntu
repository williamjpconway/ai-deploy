#!/usr/bin/env python3
"""Onboard an Ubuntu VM as a verified Ansible target (spec 007).

Usage: onboard-ubuntu --name <inventory-name> --ip <ip>
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from onboard.cli import main  # noqa: E402
from onboard.profiles import UBUNTU  # noqa: E402

sys.exit(main(profile=UBUNTU))
